#include <AK/ByteBuffer.h>
#include <LibWebCommon/Page/DragData.h>

[ExistingCpp]
enum Web::DragDataItem::Kind : u8 {
    Text,
    File,
}

[ExistingCpp]
struct Web::DragDataItem {
    Web::DragDataItem::Kind kind;
    String type;
    String text;
    ByteBuffer file_data;
    String file_name;
}

[ExistingCpp]
struct Web::DragData {
    Vector<Web::DragDataItem> items;
}
